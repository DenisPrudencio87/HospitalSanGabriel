# Copy to .env; keep secrets outside Git. Paths are resolved from repository root.
SQL_SERVER=localhost\SQLEXPRESS
SQL_DATABASE=HospitalSanGabriel
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_AUTH=windows
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=yes
# Local SQL Express often uses a self-signed certificate. Use no with a trusted certificate.
SQL_TRUST_CERTIFICATE=yes
# Generate during setup; never use this placeholder as a secret.
JWT_SECRET=
JWT_MINUTES=60
EXPIRY_DAYS=30
API_PORT=8000
